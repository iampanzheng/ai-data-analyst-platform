# P1 Phase 2 — Stage 2.4 deterministic routing example
# Existing single-provider LLM_* variables remain supported when routing is disabled.

LLM_ROUTING_ENABLED=true
LLM_ROUTING_DEFAULT_ROUTE=remote
LLM_ROUTING_ALLOW_REMOTE=true
LLM_ROUTING_ALLOW_LOCAL=true

# Remote / interactive default — measured Stage 2.2 baseline: Groq GPT-OSS 20B.
LLM_REMOTE_PROVIDER=openai-compatible
LLM_REMOTE_BASE_URL=https://api.groq.com/openai/v1
LLM_REMOTE_API_KEY=replace-with-your-groq-api-key
LLM_REMOTE_MODEL=openai/gpt-oss-20b
LLM_REMOTE_TIMEOUT_SECONDS=60
LLM_REMOTE_MAX_RETRIES=2
LLM_REMOTE_RETRY_BACKOFF_SECONDS=0.5
LLM_REMOTE_MAX_RETRY_AFTER_SECONDS=60
LLM_REMOTE_REASONING_EFFORT=low
LLM_REMOTE_DISABLE_THINKING=false

# Local / privacy-offline route — measured Stage 2.2 baseline: Ollama Qwen3 8B.
LLM_LOCAL_PROVIDER=openai-compatible
LLM_LOCAL_BASE_URL=http://host.docker.internal:11434
LLM_LOCAL_API_KEY=ollama
LLM_LOCAL_MODEL=qwen3:8b
LLM_LOCAL_TIMEOUT_SECONDS=120
LLM_LOCAL_MAX_RETRIES=1
LLM_LOCAL_RETRY_BACKOFF_SECONDS=0.5
LLM_LOCAL_MAX_RETRY_AFTER_SECONDS=60
LLM_LOCAL_REASONING_EFFORT=
LLM_LOCAL_DISABLE_THINKING=true

# Stage 2.4 intentionally does not perform automatic runtime fallback.

# Stage 2.5 reliability / fallback / cost control
LLM_ROUTING_FALLBACK_ENABLED=true
LLM_ROUTING_FALLBACK_ERROR_CODES=LLM_TIMEOUT,LLM_CONNECTION_ERROR,LLM_RATE_LIMIT,LLM_SERVER_ERROR
# 0 disables the per-request post-usage budget guard.
LLM_ROUTING_MAX_ESTIMATED_COST_USD=0
LLM_REMOTE_INPUT_COST_PER_1M=0.075
LLM_REMOTE_OUTPUT_COST_PER_1M=0.30
LLM_LOCAL_INPUT_COST_PER_1M=0
LLM_LOCAL_OUTPUT_COST_PER_1M=0
