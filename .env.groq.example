DATABASE_URL=postgresql://analyst:analyst@postgres:5432/ai_analyst
SQL_MAX_ROWS=1000
SQL_STATEMENT_TIMEOUT_MS=3000

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-with-your-groq-api-key
LLM_MODEL=openai/gpt-oss-20b

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_MAX_RETRY_AFTER_SECONDS=60
LLM_EVAL_DELAY_SECONDS=30

LLM_REASONING_EFFORT=low
LLM_DISABLE_THINKING=false

LLM_INPUT_COST_PER_1M=0.075
LLM_OUTPUT_COST_PER_1M=0.30

VALUE_GROUNDING_MAX_VALUES=20
