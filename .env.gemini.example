# Stage 2.1B — Gemini 3.8 Flash via Google's OpenAI-compatible endpoint
DATABASE_URL=postgresql://analyst:analyst@postgres:5432/ai_analyst
SQL_MAX_ROWS=1000
SQL_STATEMENT_TIMEOUT_MS=3000

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=replace-with-your-gemini-api-key
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_REASONING_EFFORT=low
LLM_DISABLE_THINKING=false

# Free Tier is currently free of charge. Keep these at 0 for actual-cost smoke runs.
# Current paid standard rates through 2026-12-31 are $0.75/M input and $3.75/M output.
LLM_INPUT_COST_PER_1M=0
LLM_OUTPUT_COST_PER_1M=0

VALUE_GROUNDING_MAX_VALUES=20
