# P1 Phase 2 — Stage 2.1A local Ollama baseline
# Copy the relevant values into .env; do not commit secrets for cloud providers.

LLM_PROVIDER=openai-compatible
# FastAPI runs in Docker; on Docker Desktop for macOS, this reaches Ollama on the host.
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_DISABLE_THINKING=true
LLM_INPUT_COST_PER_1M=0
LLM_OUTPUT_COST_PER_1M=0

# Bounded low-cardinality value grounding for schema context
VALUE_GROUNDING_MAX_VALUES=20
