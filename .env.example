DATABASE_URL=postgresql://analyst:analyst@postgres:5432/ai_analyst
SQL_MAX_ROWS=1000
SQL_STATEMENT_TIMEOUT_MS=3000
LLM_PROVIDER=mock
LLM_MODEL=
EMBEDDING_MODEL=
LOG_LEVEL=INFO
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_DISABLE_THINKING=true
LLM_INPUT_COST_PER_1M=0
LLM_OUTPUT_COST_PER_1M=0

# Bounded low-cardinality value grounding for schema context
VALUE_GROUNDING_MAX_VALUES=20
