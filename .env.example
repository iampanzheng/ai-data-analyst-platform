# Local development defaults. Copy to .env; never commit real secrets.
# Published service ports bind to 127.0.0.1 only by default.
POSTGRES_DB=ai_analyst
POSTGRES_USER=analyst
# Local-development compatibility default. Existing postgres_data volumes may already use this password.
# Override it for fresh non-local deployments; changing it does not rotate an existing PostgreSQL volume.
POSTGRES_PASSWORD=analyst
POSTGRES_PORT=5432
FASTAPI_PORT=8000
GATEWAY_PORT=8080
WEB_PORT=5173
CORS_ALLOWED_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api

# DATABASE_URL is useful for host-side tooling; Compose constructs its internal URL
# from the POSTGRES_* values above. Keep passwords URL-safe when using URI form.
DATABASE_URL=postgresql://analyst:analyst@localhost:5432/ai_analyst
SQL_MAX_ROWS=1000
SQL_STATEMENT_TIMEOUT_MS=3000
LOG_LEVEL=INFO
VALUE_GROUNDING_MAX_VALUES=20

# Single-provider mode (default deterministic local development path)
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_MAX_RETRY_AFTER_SECONDS=60
LLM_EVAL_DELAY_SECONDS=0
LLM_REASONING_EFFORT=
LLM_DISABLE_THINKING=true
LLM_INPUT_COST_PER_1M=0
LLM_OUTPUT_COST_PER_1M=0

# Deterministic routing / fallback. Disabled by default.
LLM_ROUTING_ENABLED=false
LLM_ROUTING_DEFAULT_ROUTE=remote
LLM_ROUTING_ALLOW_REMOTE=true
LLM_ROUTING_ALLOW_LOCAL=true
LLM_ROUTING_FALLBACK_ENABLED=true
LLM_ROUTING_FALLBACK_ERROR_CODES=LLM_TIMEOUT,LLM_CONNECTION_ERROR,LLM_RATE_LIMIT,LLM_SERVER_ERROR
LLM_ROUTING_MAX_ESTIMATED_COST_USD=0

# Remote route (configure secrets only in .env or the process environment)
LLM_REMOTE_PROVIDER=openai-compatible
LLM_REMOTE_BASE_URL=
LLM_REMOTE_API_KEY=
LLM_REMOTE_MODEL=
LLM_REMOTE_TIMEOUT_SECONDS=60
LLM_REMOTE_MAX_RETRIES=2
LLM_REMOTE_RETRY_BACKOFF_SECONDS=0.5
LLM_REMOTE_MAX_RETRY_AFTER_SECONDS=60
LLM_REMOTE_REASONING_EFFORT=low
LLM_REMOTE_DISABLE_THINKING=false
LLM_REMOTE_INPUT_COST_PER_1M=0.075
LLM_REMOTE_OUTPUT_COST_PER_1M=0.30

# Local/privacy route
LLM_LOCAL_PROVIDER=openai-compatible
LLM_LOCAL_BASE_URL=http://host.docker.internal:11434
LLM_LOCAL_API_KEY=ollama
LLM_LOCAL_MODEL=qwen3:8b
LLM_LOCAL_TIMEOUT_SECONDS=120
LLM_LOCAL_MAX_RETRIES=1
LLM_LOCAL_RETRY_BACKOFF_SECONDS=0.5
LLM_LOCAL_MAX_RETRY_AFTER_SECONDS=60
LLM_LOCAL_REASONING_EFFORT=
LLM_LOCAL_DISABLE_THINKING=true
LLM_LOCAL_INPUT_COST_PER_1M=0
LLM_LOCAL_OUTPUT_COST_PER_1M=0

# Reserved for later RAG work; currently unused by the core pipeline.
EMBEDDING_MODEL=
